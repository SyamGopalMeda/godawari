# Copy to .env and edit. All keys are prefixed PUSHKAR_.
PUSHKAR_DEV_MODE=true                 # false in production: OTPs then go only to the SMS gateway
PUSHKAR_DATABASE_URL=sqlite:///./pushkar.db
# PUSHKAR_DATABASE_URL=postgresql+psycopg://pushkar:pushkar@db:5432/pushkar
PUSHKAR_JWT_SECRET=change-me-to-a-long-random-string
PUSHKAR_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
PUSHKAR_SEED_ON_START=true            # demo data; false once real data is loaded
PUSHKAR_BOOTSTRAP_ADMIN_USERNAME=admin
PUSHKAR_BOOTSTRAP_ADMIN_PASSWORD=admin12345
PUSHKAR_CROWD_STALE_SECONDS=900
